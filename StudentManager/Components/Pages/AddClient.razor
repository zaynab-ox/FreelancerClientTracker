@page "/add-client"
@using FreelancerClientTracker.Models
@using FreelancerClientTracker.Data
@inject AppDbContext db
@inject NavigationManager Nav
@rendermode InteractiveServer

<div class="container mt-5">
    <div class="card shadow-sm border-0 rounded-4 mx-auto" style="max-width: 500px;">
        <div class="card-body p-4">
            <h4 class="fw-bold mb-4">Add New Client</h4>
            
            <div class="mb-3">
                <label class="form-label text-muted">Full Name</label>
                <input class="form-control rounded-3" @bind="newClient.Name" placeholder="e.g. John Doe" />
            </div>

            <div class="mb-3">
                <label class="form-label text-muted">Email Address</label>
                <input type="email" class="form-control rounded-3" @bind="newClient.Email" placeholder="john@example.com" />
            </div>

            <div class="mb-3">
                <label class="form-label text-muted">Phone Number</label>
                <input class="form-control rounded-3" @bind="newClient.Phone" placeholder="+1 234 567 890" />
            </div>

            <div class="mb-4">
                <label class="form-label text-muted">Notes</label>
                <textarea class="form-control rounded-3" @bind="newClient.Notes" rows="2"></textarea>
            </div>

            <button class="btn btn-dark w-100 py-2 rounded-pill fw-bold" @onclick="SaveClient">
                Save Client
            </button>
        </div>
    </div>
</div>

@code {
    Client newClient = new();

    void SaveClient()
    {
        if (!string.IsNullOrWhiteSpace(newClient.Name))
        {
            db.Clients.Add(newClient);
            db.SaveChanges();
            Nav.NavigateTo("/clients");
        }
    }
}