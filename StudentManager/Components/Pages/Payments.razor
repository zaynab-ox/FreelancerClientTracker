@page "/payments"
@using FreelancerClientTracker.Data
@inject AppDbContext db
@rendermode InteractiveServer

<div class="container-fluid mt-4 px-4">
    <div class="mb-5">
        <h2 class="fw-bold" style="color: #1c1c2d !important; font-size: 2.5rem;">Payment Tracking</h2>
        <p class="fw-bold" style="color: #64748b;">History of all transactions and pending bills</p>
    </div>

    @* Dark Box Container for the Table *@
    <div class="card border-0 shadow-lg" style="background: #252538 !important; border-radius: 15px !important; overflow: hidden;">
        <div class="table-responsive">
            <table class="table table-dark table-hover mb-0" style="--bs-table-bg: transparent;">
                <thead>
                    <tr style="border-bottom: 2px solid #31314a;">
                        <th class="p-4 small fw-bold text-uppercase" style="color: #a0a0b8;">ID</th>
                        <th class="p-4 small fw-bold text-uppercase" style="color: #a0a0b8;">Project</th>
                        <th class="p-4 small fw-bold text-uppercase" style="color: #a0a0b8;">Amount</th>
                        <th class="p-4 small fw-bold text-uppercase" style="color: #a0a0b8;">Status</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var p in db.Payments.ToList())
                    {
                        <tr style="border-bottom: 1px solid #31314a;">
                            <td class="p-4 align-middle fw-bold text-white">#@p.Id</td>
                            <td class="p-4 align-middle text-white">Project @p.ProjectId</td>
                            <td class="p-4 align-middle fw-bold" style="color: #CEDDBB;">$@p.Amount.ToString("N2")</td>
                            <td class="p-4 align-middle">
                                <span class="badge rounded-pill px-3 py-2"
                                      style="background: rgba(0, 212, 255, 0.15); color: #00d4ff; border: 1px solid rgba(0, 212, 255, 0.3);">
                                    @p.Status
                                </span>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>